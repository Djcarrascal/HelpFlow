            "  pm.expect(pm.response.json().errores).to.have.property('correo');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"99887766\",\n  \"nombre\": \"Pedro\",\n  \"correo\": \"pedro@gmail.com\",\n  \"password\": \"Segura2026*\",\n  \"sede\": \"MEDELLIN\",\n  \"area\": \"VENTAS\"\n}" }
          }
        },
        {
          "name": "Login Ana",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('login 200', () => pm.response.to.have.status(200));",
