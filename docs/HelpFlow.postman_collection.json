    {
      "name": "2. Tickets - flujo feliz",
      "item": [
        {
          "name": "Crear ticket (Ana)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('ticket creado', () => pm.response.to.have.status(201));",
            "const t = pm.response.json();",
            "pm.collectionVariables.set('ticketId', t.id);",
            "if (t.tecnicoCodigo) {",
            "  pm.collectionVariables.set('tecnicoCorreo', 'tec' + t.tecnicoCodigo.substring(4) + '@helpflow.com');",
            "}",
            "pm.test('queda ASIGNADO', () => pm.expect(t.estado).to.eql('ASIGNADO'));"
          ] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAna}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets",
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Sin acceso a la VPN\",\n  \"descripcion\": \"Desde esta mañana la VPN rechaza la conexión\",\n  \"categoria\": \"RED\",\n  \"prioridad\": \"ALTA\",\n  \"sede\": \"BARRANQUILLA\",\n  \"activoAfectado\": \"Portátil ACT-1032\"\n}" }
          }
        },
        {
          "name": "Listar mis tickets (Ana)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));"
          ] } }],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAna}}" }] },
            "url": "{{baseUrl}}/api/tickets"
          }
        },
        {
          "name": "Historial del ticket",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('CREADO y ASIGNADO', () => {",
            "  const h = pm.response.json();",
            "  pm.expect(h[0].accion).to.eql('CREADO');",
            "  pm.expect(h[1].accion).to.eql('ASIGNADO');",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenAna}}" }] },
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/historial"
          }
        },
        {
          "name": "Login técnico asignado",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('login 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('tokenTecnico', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{tecnicoCorreo}}\",\n  \"password\": \"Password123*\"\n}" }
          }
        },
        {
          "name": "Técnico: EN_PROGRESO",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 EN_PROGRESO', () => pm.expect(pm.response.json().estado).to.eql('EN_PROGRESO'));"
          ] } }],
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenTecnico}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"EN_PROGRESO\"\n}" }
          }
        },
        {
          "name": "Técnico: RESUELTO sin observación (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 con errores.observacion', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().errores).to.have.property('observacion');",
            "});"
          ] } }],
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenTecnico}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"RESUELTO\"\n}" }
          }
        },
        {
          "name": "Técnico: RESUELTO con observación",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 RESUELTO', () => pm.expect(pm.response.json().estado).to.eql('RESUELTO'));"
          ] } }],
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenTecnico}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"RESUELTO\",\n  \"observacion\": \"Se reinició el túnel VPN\"\n}" }
          }
        },
        {
          "name": "Transición inválida RESUELTO -> CANCELADO (409)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('409', () => pm.response.to.have.status(409));"
          ] } }],
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenTecnico}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"CANCELADO\",\n  \"observacion\": \"x\"\n}" }
          }
        },
        {
          "name": "Técnico: CERRADO",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 CERRADO', () => pm.expect(pm.response.json().estado).to.eql('CERRADO'));"
          ] } }],
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenTecnico}}" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}/estado",
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"CERRADO\",\n  \"observacion\": \"Confirmado con el usuario\"\n}" }
          }
        }
      ]
    },
