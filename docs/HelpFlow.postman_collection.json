            "pm.test('técnico de RED (TEC-009 a TEC-012)', () => pm.expect(['TEC-009','TEC-010','TEC-011','TEC-012']).to.include(r.tecnicoId));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{dispatchUrl}}/technician-dispatch",
            "body": { "mode": "raw", "raw": "{\n  \"ticketId\": 125,\n  \"categoria\": \"RED\",\n  \"prioridad\": \"ALTA\"\n}" }
          }
        },
        {
          "name": "Dispatch con categoría inválida (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{dispatchUrl}}/technician-dispatch",
            "body": { "mode": "raw", "raw": "{\n  \"ticketId\": 125,\n  \"categoria\": \"COCINA\",\n  \"prioridad\": \"ALTA\"\n}" }
          }
        }
      ]
    }
  ]
}
