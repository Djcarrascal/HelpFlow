    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registrar usuario (201)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "// En una segunda ejecución da 409 porque el documento ya existe",
            "pm.test('201 o 409', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
            "if (pm.response.code === 201) pm.collectionVariables.set('nuevoUsuarioId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"documento\": \"55667788\",\n  \"nombre\": \"Marta Ruiz\",\n  \"correo\": \"marta@helpflow.com\",\n  \"password\": \"Segura2026*\",\n  \"sede\": \"MEDELLIN\",\n  \"area\": \"COMPRAS\"\n}" }
          }
        },
        {
